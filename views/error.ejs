<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, -apple-system, sans-serif; background: #f6f7f9; color: #111; line-height: 1.5; padding: 2rem 1rem; max-width: 480px; margin: 0 auto; }
    nav { display: flex; gap: 1rem; align-items: center; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #ddd; }
    nav a { text-decoration: none; color: #2563eb; font-weight: 500; font-size: 0.95rem; }
    nav a:hover { text-decoration: underline; }
    h1 { font-size: 1.75rem; letter-spacing: -0.02em; margin-bottom: 0.25rem; }
    .subtitle { color: #666; font-size: 0.9rem; margin-bottom: 1.5rem; }
    .error-box { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 1.25rem; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
    .error-box p { color: #333; font-size: 0.95rem; margin-bottom: 0.5rem; }
    .error-box p:first-child { font-weight: 600; color: #dc2626; }
  </style>
</head>
<body>
  <nav>
    <a href="/">Home</a>
  </nav>

  <h1>Error</h1>
  <p class="subtitle">Something went wrong.</p>

  <div class="error-box">
    <p><% error.status %></p>
    <p><% error.message %></p>
  </div>
</body>
</html>
