<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, -apple-system, sans-serif; background: #f6f7f9; color: #111; line-height: 1.5; padding: 2rem 1rem; max-width: 480px; margin: 0 auto; }
    nav { display: flex; gap: 1rem; align-items: center; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #ddd; }
    nav a { text-decoration: none; color: #2563eb; font-weight: 500; font-size: 0.95rem; }
    nav a:hover { text-decoration: underline; }
    h1 { font-size: 1.75rem; letter-spacing: -0.02em; margin-bottom: 0.25rem; }
    .subtitle { color: #666; font-size: 0.9rem; margin-bottom: 1.5rem; }
    form { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 1.25rem; box-shadow: 0 1px 2px rgba(0,0,0,0.04); display: flex; flex-direction: column; gap: 1rem; }
    label { display: flex; flex-direction: column; font-size: 0.85rem; font-weight: 500; gap: 0.35rem; }
    input { padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.9rem; font-family: inherit; }
    input:focus { outline: none; border-color: #2563eb; }
    button { background: #111; color: #fff; border: none; padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; font-size: 0.9rem; font-weight: 500; margin-top: 0.5rem; align-self: flex-start; }
    button:hover { background: #333; }
    .errors { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 0.75rem; border-radius: 6px; font-size: 0.85rem; }
    .errors ul { list-style: none; }
    .errors li { margin-bottom: 0.25rem; }
  </style>
</head>
<body>
  <nav>
    <a href="/">Home</a>
  </nav>

  <h1>Login</h1>
  <p class="subtitle">Sign in to your account.</p>

  <% if (req.session.messages && req.session.messages.length > 0) { %>
    <div class="errors">
      <ul>
        <% req.session.messages.forEach(function(msg) { %>
          <li><%= msg %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form action="/login" method="post">
    <label>
      Username
      <input type="text" name="username" value="<%= typeof body !== 'undefined' ? body.username : '' %>">
    </label>
    <label>
      Password
      <input type="password" name="password" value="<%= typeof body !== 'undefined' ? body.password : '' %>">
    </label>
    <button type="submit">Login</button>
  </form>
</body>
</html>
