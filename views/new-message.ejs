<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>new message</title>
</head>
<body>
  <% if (errors) { %>
    <ul>
      <% errors.forEach(function(error) { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  <% } %>
  <form action="/new-message" method="post">
    <label>
      title
      <input type="text" name="title" value="<%= body?.title %>">
    </label>
    <label>
      content
      <input type="text" name="content" value="<%= body?.content %>">
    </label>
    <button type="submit">post</button>
  </form>
</body>
</html>